{{- /* Environment detection (runs once at `chezmoi init`). Only is_work is   */ -}}
{{- /* consumed, by .chezmoiignore + .chezmoiexternal. Container and OS gating */ -}}
{{- /* happen at runtime in .chezmoitemplates/setup-body.sh. See CLAUDE.md.    */ -}}
{{- $fqdn := .chezmoi.fqdnHostname -}}
{{- $isWork := or (hasSuffix ".c.googlers.com" $fqdn) (hasSuffix ".corp.google.com" $fqdn) (hasSuffix ".roam.internal" $fqdn) -}}
{{- /* Pin sourceDir so a custom `--source` (e.g. Codespaces clones to        */ -}}
{{- /* ~/dotfiles) survives future `chezmoi init` runs.                        */ -}}
sourceDir = {{ .chezmoi.sourceDir | quote }}

[data]
    is_work = {{ $isWork }}
