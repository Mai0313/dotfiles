{{- /* Environment detection (runs once at `chezmoi init`). OS gating uses    */ -}}
{{- /* chezmoi built-ins instead. See CLAUDE.md.                               */ -}}
{{- $fqdn := .chezmoi.fqdnHostname -}}
{{- $isWork := or (hasSuffix ".c.googlers.com" $fqdn) (hasSuffix ".corp.google.com" $fqdn) (hasSuffix ".roam.internal" $fqdn) -}}
{{- /* Devcontainers and Codespaces set one of these variables, and Docker /  */ -}}
{{- /* Podman leave a marker file in every container.                         */ -}}
{{- $isContainer := false -}}
{{- if or (env "CODESPACES") (env "REMOTE_CONTAINERS") (env "DEVCONTAINER") (stat "/.dockerenv") (stat "/run/.containerenv") -}}
{{-   $isContainer = true -}}
{{- end -}}
{{- /* Nothing sets this for you: a cloud agent environment (Claude Code,    */ -}}
{{- /* Codex) exports it in its setup script before `chezmoi init`.           */ -}}
{{- $isCloud := eq (env "CLOUD_ENV") "true" -}}
{{- /* Pin sourceDir so a custom `--source` (e.g. Codespaces clones to        */ -}}
{{- /* ~/dotfiles) survives future `chezmoi init` runs.                        */ -}}
sourceDir = {{ .chezmoi.sourceDir | quote }}

[data]
    is_work = {{ $isWork }}
    is_container = {{ $isContainer }}
    is_cloud = {{ $isCloud }}
