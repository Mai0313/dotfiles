{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 365,
  "skillListingBudgetFraction": 0.05,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_THRIFTY_SONIC": "0",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1"
  },
  "attribution": {
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "skillOverrides": {
    "buganizer-cli": "name-only",
    "critique": "name-only",
    "gcalendar": "name-only",
    "gchat": "name-only",
    "gdocs": "name-only",
    "gdrive": "name-only",
    "gerrit": "name-only",
    "gforms": "name-only",
    "gmail": "name-only",
    "gmeet": "name-only",
    "google-workspace": "name-only",
    "gsheets": "name-only",
    "gslides": "name-only",
    "x20": "name-only"
  },
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\": {\"hookEventName\": \"PermissionRequest\", \"decision\": {\"behavior\": \"allow\"}}}'"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh",
    "padding": 0
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "bash ~/.claude/subagent-statusline-command.sh"
  },
  "footerLinksRegexes": [
    {
      "type": "regex",
      "pattern": "\\bb/(?<id>\\d+)\\b",
      "url": "https://b.corp.google.com/issues/{id}"
    },
    {
      "type": "regex",
      "pattern": "\\bgpar/(?<id>\\d+)\\b",
      "url": "https://googleplex-polygon-android-review.git.corp.google.com/{id}"
    },
    {
      "type": "regex",
      "pattern": "\\bgpar/(?<hash>[0-9a-f]*[a-f][0-9a-f]*)\\b",
      "url": "https://googleplex-polygon-android-review.git.corp.google.com/q/{hash}"
    },
    {
      "type": "regex",
      "pattern": "\\bcl/(?<id>\\d+)\\b",
      "url": "https://critique.corp.google.com/{id}"
    },
    {
      "type": "regex",
      "pattern": "\\bag/(?<id>\\d+)\\b",
      "url": "https://googleplex-android-review.git.corp.google.com/{id}"
    },
    {
      "type": "regex",
      "pattern": "\\bab/(?<id>\\d+)\\b",
      "url": "https://android-build.corp.google.com/ab/{id}"
    },
    {
      "type": "regex",
      "pattern": "(?<![\\w/~.])go/(?<link>[a-zA-Z0-9][\\w.-]*)",
      "url": "https://goto2.corp.google.com/{link}"
    }
  ],
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      },
      "autoUpdate": true
    },
    "claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code"
      },
      "autoUpdate": true
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      },
      "autoUpdate": true
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      },
      "autoUpdate": true
    },
    "knowledge-work-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/knowledge-work-plugins"
      }
    }
  },
  "viewMode": "default",
  "language": "zh-TW",
  "feedbackSurveyRate": 0,
  "feedbackDrafts": "quiet",
  "spinnerTipsEnabled": true,
  "effortLevel": "xhigh",
  "showClearContextOnPlanAccept": false,
  "askUserQuestionTimeout": "never",
  "tui": "fullscreen",
  "autoMemoryEnabled": true,
  "autoMemoryDirectory": "~/.memories",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "editorMode": "normal",
  "preferredNotifChannel": "auto",
  "autoCompactEnabled": true,
  "switchModelsOnFlag": false,
  "autoScrollEnabled": true,
  "fileCheckpointingEnabled": true,
  "showTurnDuration": true,
  "terminalProgressBarEnabled": true,
  "teammateMode": "auto",
  "inputNeededNotifEnabled": false,
  "agentPushNotifEnabled": false,
  "skipAutoPermissionPrompt": true,
  "useAutoModeDuringPlan": true,
  "autoInstallIdeExtension": false
}
