#!/bin/bash
# What Pixel boards are attached, and what state each one is in.
#
# Stands in for /google/bin/releases/android/flashstation/list_devices for the
# everyday "which board is this" question. That one is the authority and is still
# worth reaching for when you want its marketing names or its flashstation
# session log, but it lives on binfs, so any invocation can be the one that goes
# quiet for minutes while its tool chain is fetched. This asks adb and fastboot,
# which are already local, and answers in well under a second.
#
# What it adds over plain `adb devices` / `fastboot devices`: the codename, which
# is how every task names a board, and the running bootloader build, which is
# almost always the next thing you want to know.
#
# The original is still at /google/bin/releases/android/flashstation/list_devices
# and is not aliased, so reaching for it has to be deliberate.
#
# It does one thing beyond listing. `list_devices reboot bootloader <board>` and
# `list_devices reboot <board>` spell the two adb / fastboot commands they stand
# for, and pick between adb and fastboot from the mode the listing just read, so a
# board goes to the bootloader or back to the system from whatever state it is in
# now. `<board>` is a codename or a serial, or `all` for every attached board. A
# board always has to be named, because a workstation usually has several attached
# and rebooting the wrong one is not what anybody meant.

set -uo pipefail

target=""
reboot_to=""
case "${1:-}" in
    "") ;;
    reboot)
        shift
        [ "${1:-}" = bootloader ] && { reboot_to=bootloader; shift; }
        target=${1:-}
        [ -z "$target" ] && { echo "usage: list_devices reboot [bootloader] <codename|serial|all>" >&2; exit 1; }
        ;;
    *)
        echo "usage: list_devices [reboot [bootloader] <codename|serial|all>]" >&2
        exit 1
        ;;
esac

# A second fastboot against a board that already has one in flight wedges its
# bootloader: ABL's transport has no timeout, so whichever command loses the USB
# endpoint blocks forever and the board answers nothing until somebody walks over
# and holds the power button. Enumerating is not worth that risk, so if any
# fastboot is already running we report the adb side and say what we skipped.
fastboot_busy=$(pgrep -x fastboot 2>/dev/null | paste -sd' ' -)

tmp=$(mktemp) || exit 1
trap 'rm -f "$tmp"' EXIT

rows=""
add() { rows+="$1"$'\t'"$2"$'\t'"$3"$'\t'"$4"$'\t'"$5"$'\n'; }
dash() { if [ -n "${1:-}" ]; then printf '%s' "$1"; else printf -- '-'; fi; }

# ---- adb ----
# adb is safe to talk to freely; it has none of fastboot's blocking behaviour.
while read -r serial state rest; do
    [ -z "${serial:-}" ] && continue
    [ "$serial" = "List" ] && continue

    # `device:` in adb's long listing is the codename. Keep it as the fallback
    # for a board that is present but not answering a shell (unauthorized,
    # offline, still booting).
    codename=$(printf '%s' "${rest:-}" | grep -o 'device:[^ ]*' | cut -d: -f2)
    bootloader=""
    buildid=""

    if [ "$state" = "device" ]; then
        # `< /dev/null` is load-bearing: `adb shell` forwards stdin to the device
        # even with a command attached, and this loop's stdin is the listing it is
        # iterating, so without it the first board swallows every line after its
        # own and the rest of the boards silently vanish from the output.
        if adb -s "$serial" shell 'getprop ro.product.name; getprop ro.bootloader; getprop ro.build.id' > "$tmp" 2>/dev/null < /dev/null; then
            name=$(sed -n '1p' "$tmp" | tr -d '\r')
            bootloader=$(sed -n '2p' "$tmp" | tr -d '\r')
            buildid=$(sed -n '3p' "$tmp" | tr -d '\r')
            [ -n "$name" ] && codename=$name
        fi
    fi

    add "$(dash "$codename")" "adb/$state" "$serial" "$(dash "$bootloader")" "$(dash "$buildid")"
done < <(adb devices -l 2>/dev/null)

# ---- fastboot ----
if [ -n "$fastboot_busy" ]; then
    echo "list_devices: another fastboot is running (pid $fastboot_busy), skipping the fastboot side" >&2
    echo "list_devices: probing now would steal its USB endpoint and wedge that board" >&2
else
    while read -r serial mode; do
        [ -z "${serial:-}" ] && continue

        # `ramdump_usb` is a normal state, not a fault, but it is invisible to
        # `fastboot devices` unless you read this column, and mistaking it for
        # normal fastboot is the usual way to waste a cycle.
        [ "${mode:-}" = "ramdump_usb" ] && mode=ramdump

        # Never pipe a fastboot command. Anything downstream that can exit early
        # sends SIGPIPE mid-reply and leaves the board's fastboot thread blocked
        # for good. Redirect to a file and read the file.
        codename=""
        fastboot -s "$serial" getvar product > "$tmp" 2>&1
        codename=$(grep -m1 '^product:' "$tmp" | awk '{print $2}')

        bootloader=""
        fastboot -s "$serial" getvar version-bootloader > "$tmp" 2>&1
        bootloader=$(grep -m1 '^version-bootloader:' "$tmp" | awk '{print $2}')

        add "$(dash "$codename")" "${mode:-fastboot}" "$serial" "$(dash "$bootloader")" "-"
    done < <(fastboot devices 2>/dev/null)
fi

if [ -z "$rows" ]; then
    # Saying "none attached" would be a lie when the fastboot side was never
    # looked at; boards in fastboot or ramdump are invisible to adb.
    if [ -n "$fastboot_busy" ]; then
        echo "No adb devices. The fastboot side was not probed, so any board in fastboot or ramdump is unaccounted for."
        exit 0
    fi
    echo "No devices attached."
    exit 1
fi

if [ -n "$target" ]; then
    # No board is ever called `all`, so it needs no flag syntax to tell it apart
    # from a codename.
    if [ "$target" = all ]; then
        match=$(printf '%s' "$rows")
    else
        match=$(printf '%s' "$rows" | awk -F'\t' -v t="$target" '$1 == t || $3 == t')
    fi

    n=$(printf '%s' "$match" | grep -c .)
    if [ "$n" -eq 0 ]; then
        echo "list_devices: no attached board matches '$target'" >&2
        exit 1
    fi
    if [ "$n" -gt 1 ] && [ "$target" != all ]; then
        echo "list_devices: '$target' matches $n boards, name one by serial:" >&2
        printf '%s' "$match" | cut -f3 | sed 's/^/  /' >&2
        exit 1
    fi

    status=0
    while IFS=$'\t' read -r _ mode serial _; do
        # fastboot and ramdump both speak the fastboot transport; every other mode
        # in this table came from adb. One board at a time, each command finishing
        # before the next starts, so two fastboots never share an endpoint.
        case "$mode" in
            adb/*) cmd=(adb -s "$serial" reboot) ;;
            *)     cmd=(fastboot -s "$serial" reboot) ;;
        esac
        [ -n "$reboot_to" ] && cmd+=("$reboot_to")

        echo "${cmd[*]}"
        "${cmd[@]}" || status=1
    done < <(printf '%s\n' "$match")
    exit $status
fi

echo "Connected devices:"
{ printf 'CODENAME\tMODE\tSERIAL\tBOOTLOADER\tBUILD\n'; printf '%s' "$rows"; } \
    | column -t -s $'\t' | sed 's/^/  /'

# Every board needs -s <serial> on every later command, and forgetting it on a
# multi-board workstation is how the wrong device gets flashed.
[ "$(printf '%s' "$rows" | grep -c .)" -gt 1 ] && \
    echo && echo "  More than one board attached: pin every adb/fastboot command with -s <serial>."

exit 0
