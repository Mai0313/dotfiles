#!/bin/bash
# Rename CLAUDE.md to AGENTS.md and leave CLAUDE.md behind as a symlink.

set -euo pipefail

if root=$(git rev-parse --show-toplevel 2>/dev/null); then
  cd "$root"
fi

if [[ -L CLAUDE.md ]]; then
  echo "CLAUDE.md is already a symlink, nothing to do."
  exit 0
fi

if [[ ! -f CLAUDE.md ]]; then
  echo "CLAUDE.md not found." >&2
  exit 1
fi

if [[ -e AGENTS.md ]]; then
  echo "AGENTS.md already exists, merge it yourself first." >&2
  exit 1
fi

if git ls-files --error-unmatch CLAUDE.md >/dev/null 2>&1; then
  git mv CLAUDE.md AGENTS.md
  ln -s AGENTS.md CLAUDE.md
  git add CLAUDE.md
  git commit -m 'chore: rename CLAUDE.md to AGENTS.md'
  git push origin "$(git branch --show-current)"
else
  mv CLAUDE.md AGENTS.md
  ln -s AGENTS.md CLAUDE.md
fi
