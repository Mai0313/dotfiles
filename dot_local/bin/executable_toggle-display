#!/bin/bash
# Toggle switch between Chrome Remote Desktop (crd) and local HDMI display (local)

set -e

STATUS_FILE="/var/lib/goobuntu/current_graphical_session"

if [[ -f "$STATUS_FILE" && -s "$STATUS_FILE" ]]; then
  CURRENT_MODE=$(cat "$STATUS_FILE")
else
  # Fallback to command output
  CURRENT_OUT=$(switch-graphical-session current 2>/dev/null || true)
  if [[ "$CURRENT_OUT" =~ crd ]]; then
    CURRENT_MODE="crd"
  elif [[ "$CURRENT_OUT" =~ local ]]; then
    CURRENT_MODE="local"
  else
    CURRENT_MODE="unknown"
  fi
fi

if [[ "$CURRENT_MODE" == "crd" ]]; then
  TARGET_MODE="local"
elif [[ "$CURRENT_MODE" == "local" ]]; then
  TARGET_MODE="crd"
else
  echo "Error: cannot determine the current graphical session mode ($CURRENT_MODE). Run switch-graphical-session current to check."
  exit 1
fi

echo "=========================================================="
echo "Current session: ${CURRENT_MODE}"
echo "Target session : ${TARGET_MODE}"
echo "=========================================================="

# Pass every argument through to switch-graphical-session (e.g. -y to skip the prompt)
exec sudo switch-graphical-session "$@" "${TARGET_MODE}"
