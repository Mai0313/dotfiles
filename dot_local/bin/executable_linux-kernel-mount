#!/bin/bash
# Mount ~/linux_kernel from the cloudtop over sshfs.
# The kernel tree is read-only here: this box is only used to look up code.

set -u

# Remote path is relative to the remote home; the ssh user comes from ~/.ssh/config.
# CLOUDTOP_HOST is shared with kgrep and automation-mount.
REMOTE_HOST="${CLOUDTOP_HOST:-wei0313.c.googlers.com}"
REMOTE_DIR="${LINUX_KERNEL_REMOTE_DIR:-linux_kernel}"
LOCAL_DIR="${LINUX_KERNEL_LOCAL_DIR:-$HOME/linux_kernel}"

# Tuned for a high-latency link: cache aggressively, keep several ssh channels
# open so parallel readers do not serialise, and skip compression.
SSHFS_OPTS=(
    -o reconnect
    -o ServerAliveInterval=15
    -o ServerAliveCountMax=3
    -o ConnectTimeout=10
    -o Ciphers=aes128-gcm@openssh.com
    -o Compression=no
    -o cache=yes
    -o cache_timeout=3600
    -o attr_timeout=3600
    -o entry_timeout=3600
    -o dcache_timeout=3600
    -o kernel_cache
    -o max_conns=8
    -o max_read=262144
    -o idmap=user
    -o ro
)

SERVICE="${LINUX_KERNEL_SERVICE:-linux-kernel-sshfs.service}"

# On the cloudtop itself $LOCAL_DIR is the real tree, so there is nothing to mount
# and sshfs would be pointed at its own host. Callers only ever want to end up able
# to read the tree, and that already holds here, so say so and succeed.
if [ "$(hostname -s)" = "${REMOTE_HOST%%.*}" ]; then
    action="${1:-mount}"
    if [ "$action" = daemon ]; then
        echo "$(basename "$0"): refusing to sshfs $REMOTE_HOST onto itself" >&2
        exit 1
    fi
    echo "on $REMOTE_HOST: $LOCAL_DIR is the real tree, not an sshfs mount"
    exit 0
fi

is_mounted() {
    mountpoint -q "$LOCAL_DIR"
}

# Wherever the systemd user unit is installed, it owns the mount. Working around
# it does not stick: Restart=always brings the daemon back 30s after a manual
# umount, and a hand-rolled mount is invisible to a later `systemctl stop`.
# Set LINUX_KERNEL_NO_SYSTEMD=1 to drive sshfs directly anyway.
service_installed() {
    [ -z "${LINUX_KERNEL_NO_SYSTEMD:-}" ] &&
        command -v systemctl >/dev/null 2>&1 &&
        systemctl --user cat "$SERVICE" >/dev/null 2>&1
}

# $1: mounted|unmounted. The unit takes a moment to settle after a verb.
wait_for() {
    local i=0
    while [ "$i" -lt 60 ]; do
        if [ "$1" = mounted ]; then
            is_mounted && return 0
        else
            is_mounted || return 0
        fi
        sleep 0.5
        i=$((i + 1))
    done
    return 1
}

# $1: systemctl verb, $2: state to end up in.
do_service() {
    systemctl --user "$1" "$SERVICE" || return 1
    if ! wait_for "$2"; then
        echo "$SERVICE: $1 left $LOCAL_DIR not $2" >&2
        return 1
    fi
    echo "$1 via $SERVICE: $LOCAL_DIR ($2)"
}

do_mount() {
    if is_mounted; then
        echo "already mounted: $LOCAL_DIR"
        return 0
    fi
    mkdir -p "$LOCAL_DIR"
    sshfs "$REMOTE_HOST:$REMOTE_DIR" "$LOCAL_DIR" "${SSHFS_OPTS[@]}" "$@" || return 1
    echo "mounted $REMOTE_HOST:$REMOTE_DIR -> $LOCAL_DIR (read-only)"
}

do_umount() {
    if ! is_mounted; then
        echo "not mounted: $LOCAL_DIR"
        return 0
    fi
    fusermount3 -u "$LOCAL_DIR" || fusermount3 -uz "$LOCAL_DIR"
    echo "unmounted $LOCAL_DIR"
}

case "${1:-mount}" in
    mount)   if service_installed; then do_service start mounted; else do_mount; fi ;;
    umount|unmount)
             if service_installed; then do_service stop unmounted; else do_umount; fi ;;
    # sshfs caches metadata and contents for an hour, so this is how a remote
    # `git pull` or `repo sync` becomes visible here.
    remount) if service_installed; then do_service restart mounted; else do_umount; do_mount; fi ;;
    # Runs in the foreground, for systemd.
    daemon)  mkdir -p "$LOCAL_DIR"
             exec sshfs -f "$REMOTE_HOST:$REMOTE_DIR" "$LOCAL_DIR" "${SSHFS_OPTS[@]}" ;;
    status)  service_installed && echo "service: $(systemctl --user is-active "$SERVICE")"
             if is_mounted; then
                 mount | grep " $LOCAL_DIR "
             else
                 echo "not mounted: $LOCAL_DIR"
                 exit 1
             fi ;;
    *)       echo "usage: $(basename "$0") [mount|umount|remount|status|daemon]" >&2
             exit 2 ;;
esac
