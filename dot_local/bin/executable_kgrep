#!/bin/bash
# Run ripgrep on the cloudtop instead of dragging file contents over sshfs.
# Paths come out relative to ~/linux_kernel, which is the mount point here and the
# real directory on the cloudtop, so prepend that to open a hit from anywhere else.
#
#   kgrep <rg args...>              search the whole ~/linux_kernel
#   kgrep -t c cpuidle_enter kernel_mbu_staging/kernel/aosp/drivers

set -u

# CLOUDTOP_HOST is shared with linux-kernel-mount and automation-mount.
REMOTE_HOST="${CLOUDTOP_HOST:-weichenglee.c.googlers.com}"
REMOTE_DIR="${LINUX_KERNEL_REMOTE_DIR:-linux_kernel}"

if [ $# -eq 0 ]; then
    echo "usage: $(basename "$0") <rg args...>" >&2
    exit 2
fi

case "$REMOTE_DIR" in
    /*) LOCAL_PATH="$REMOTE_DIR" ;;
    *)  LOCAL_PATH="$HOME/$REMOTE_DIR" ;;
esac

# On the cloudtop itself the tree is just a local directory, so searching it over ssh
# would be a pointless round trip back to this host. The stdin redirect still
# applies: a caller's pipe would otherwise send rg off searching stdin.
if [ "$(hostname -s)" = "${REMOTE_HOST%%.*}" ]; then
    cd "$LOCAL_PATH" || exit 1
    exec rg --line-number --color=never "$@" < /dev/null
fi

quoted=""
for arg in "$@"; do
    quoted+=" $(printf '%q' "$arg")"
done

# The remote redirect is what matters: rg sees the ssh channel as a readable pipe
# on stdin, decides to search stdin instead of the working directory, and a search
# with no path argument then silently reports no matches. -n only detaches the
# local end, so it keeps kgrep from eating a caller's pipe but does not fix that.
exec ssh -n "$REMOTE_HOST" "cd $(printf '%q' "$REMOTE_DIR") && rg --line-number --color=never$quoted < /dev/null"
