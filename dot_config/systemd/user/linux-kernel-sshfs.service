[Unit]
Description=sshfs mount of the cloudtop's ~/linux_kernel
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%h/.local/bin/linux-kernel-mount daemon
ExecStop=/bin/fusermount3 -uz %h/linux_kernel
# corpssh certs expire, so keep retrying instead of giving up at boot.
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
