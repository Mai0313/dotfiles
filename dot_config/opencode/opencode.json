{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "enabled_providers": [
    "anthropic",
    "azure",
    "copilot",
    "deepseek",
    "google",
    "openai",
    "huggingface",
    "opencode",
    "openrouter",
    "xai",
  ],
  "provider": {
    "anthropic": {
      "options": {
        "baseURL": "https://api.mai0313.com",
        "apiKey": "{env:OPENAI_API_KEY}",
        "headers": {
          "x-litellm-end-user-id": "opencode-cli"
        }
      }
    },
    "deepseek": {
      "options": {
        "baseURL": "https://api.mai0313.com",
        "apiKey": "{env:OPENAI_API_KEY}",
        "headers": {
          "x-litellm-end-user-id": "opencode-cli"
        }
      }
    },
    "google": {
      "options": {
        "baseURL": "https://api.mai0313.com",
        "apiKey": "{env:OPENAI_API_KEY}",
        "headers": {
          "x-litellm-end-user-id": "opencode-cli"
        }
      }
    },
    "openai": {
      "options": {
        "baseURL": "https://api.mai0313.com",
        "apiKey": "{env:OPENAI_API_KEY}",
        "headers": {
          "x-litellm-end-user-id": "opencode-cli"
        }
      }
    }
  },
  "server": {
    "port": 4096,
    "hostname": "0.0.0.0",
    "mdns": true,
    "cors": ["https://opencode.mai0313.com"]
  }
}